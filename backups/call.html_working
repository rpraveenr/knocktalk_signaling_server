<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KnockTalk - Video Call</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #1a1a2e;
      color: white;
      font-family: -apple-system, sans-serif;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    #status {
      font-size: 18px;
      margin-bottom: 20px;
      text-align: center;
      padding: 0 20px;
    }
    #videos {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    video {
      width: 100%;
      max-height: 45vh;
      background: #000;
      object-fit: cover;
    }
    #endBtn {
      margin-top: 20px;
      background: #e63946;
      color: white;
      border: none;
      padding: 16px 40px;
      border-radius: 50px;
      font-size: 18px;
      cursor: pointer;
      display: none;
    }
    .spinner {
      width: 50px;
      height: 50px;
      border: 4px solid rgba(255,255,255,0.2);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin-bottom: 20px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div id="waiting">
    <div class="spinner"></div>
    <div id="status">Connecting to KnockTalk...</div>
  </div>

  <div id="videos" style="display:none">
    <video id="remoteVideo" autoplay playsinline></video>
    <video id="localVideo" autoplay playsinline muted></video>
  </div>
  <button id="endBtn" onclick="endCall()">End Call</button>

  <script>
    const params = new URLSearchParams(window.location.search);
    const roomId = params.get('room');

    if (!roomId) {
      document.getElementById('status').textContent = 'Invalid QR code. No room ID found.';
    }

    const SIGNAL_SERVER = 'wss://knocktalk.duckdns.org';
    const ICE_CONFIG = {
      iceServers: [
        { urls: 'stun:stun.l.google.com:19302' },
        {
          urls: [
            'turn:knocktalk.duckdns.org:3478',
            'turns:knocktalk.duckdns.org:5349'
          ],
          username: 'knocktalkadm',
          credential: 'BUuBetKwBf&daR@1!1'
        }
      ]
    };

    let ws, pc, localStream;
    let pingInterval;

    async function start() {
      try {
        // Get camera/mic first
        localStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user' },
          audio: true
        });
        document.getElementById('localVideo').srcObject = localStream;

        // Connect to signaling server
        ws = new WebSocket(SIGNAL_SERVER);

        ws.onopen = () => {
          console.log('WebSocket connected');
          document.getElementById('status').textContent = 'Waiting for host to answer...';
          ws.send(JSON.stringify({ type: 'guest-join', roomId: roomId }));

          // Keep connection alive
          pingInterval = setInterval(() => {
            if (ws && ws.readyState === WebSocket.OPEN) {
              ws.send(JSON.stringify({ type: 'ping' }));
            }
          }, 20000);
        };

        ws.onmessage = async (event) => {
          const data = JSON.parse(event.data);
          console.log('Received from server:', data.type);

          if (data.type === 'waiting-for-host') {
            document.getElementById('status').textContent = '🔔 Ringing... waiting for answer';
          }

          if (data.type === 'call-accepted') {
            console.log('Call accepted, setting up peer connection');
            document.getElementById('status').textContent = 'Call accepted! Connecting...';
            await setupPeerConnection();
            console.log('Peer connection ready, sending guest-ready');
            ws.send(JSON.stringify({
              type: 'guest-ready',
              roomId: roomId
            }));
          }

          if (data.type === 'call-ended' || data.type === 'host-disconnected') {
            console.log('Call ended by host');
            endCall();
            document.getElementById('status').textContent = 'Call ended.';
          }

          if (data.type === 'signal') {
            const signal = data.signal;
            console.log('Signal received:', signal.type || 'candidate');

            if (signal.type === 'offer') {
              if (!pc) {
                console.log('No peer connection yet, setting up...');
                await setupPeerConnection();
              }
              await pc.setRemoteDescription(new RTCSessionDescription(signal));
              const answer = await pc.createAnswer();
              await pc.setLocalDescription(answer);
              ws.send(JSON.stringify({
                type: 'signal',
                roomId: roomId,
                signal: answer
              }));
            }

            if (signal.type === 'answer') {
              await pc.setRemoteDescription(new RTCSessionDescription(signal));
            }

            if (signal.candidate) {
              try {
                await pc.addIceCandidate(new RTCIceCandidate(signal));
              } catch (e) {
                console.error('Error adding ICE candidate:', e);
              }
            }
          }
        };

        ws.onerror = (err) => {
          console.error('WebSocket error:', err);
          document.getElementById('status').textContent = 'Connection error. Please try again.';
        };

        ws.onclose = () => {
          console.log('WebSocket closed');
          clearInterval(pingInterval);
        };

      } catch (err) {
        document.getElementById('status').textContent =
          'Camera/mic access denied. Please allow and try again.';
        console.error(err);
      }
    }

    async function setupPeerConnection() {
      if (pc) return; // Already set up

      pc = new RTCPeerConnection(ICE_CONFIG);

      // Add local tracks
      localStream.getTracks().forEach(track => {
        pc.addTrack(track, localStream);
      });

      // ICE candidates
      pc.onicecandidate = (event) => {
        if (event.candidate && ws && ws.readyState === WebSocket.OPEN) {
          ws.send(JSON.stringify({
            type: 'signal',
            roomId: roomId,
            signal: {
              candidate: event.candidate.candidate,
              sdpMid: event.candidate.sdpMid,
              sdpMLineIndex: event.candidate.sdpMLineIndex
            }
          }));
        }
      };

      // Remote video
      pc.ontrack = (event) => {
        console.log('Remote track received');
        document.getElementById('remoteVideo').srcObject = event.streams[0];
        document.getElementById('waiting').style.display = 'none';
        document.getElementById('videos').style.display = 'flex';
        document.getElementById('endBtn').style.display = 'block';
      };

      pc.onconnectionstatechange = () => {
        console.log('Connection state:', pc.connectionState);
        if (pc.connectionState === 'connected') {
          document.getElementById('status').textContent = 'Connected!';
        }
        if (pc.connectionState === 'disconnected' || pc.connectionState === 'failed') {
          endCall();
          document.getElementById('status').textContent = 'Call disconnected.';
        }
      };

      pc.oniceconnectionstatechange = () => {
        console.log('ICE state:', pc.iceConnectionState);
      };
    }

    function endCall() {
      clearInterval(pingInterval);

      if (localStream) {
        localStream.getTracks().forEach(t => t.stop());
        localStream = null;
      }

      if (pc) {
        pc.close();
        pc = null;
      }

      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.close();
        ws = null;
      }

      document.getElementById('remoteVideo').srcObject = null;
      document.getElementById('localVideo').srcObject = null;
      document.getElementById('videos').style.display = 'none';
      document.getElementById('endBtn').style.display = 'none';
      document.getElementById('waiting').style.display = 'flex';
      document.getElementById('status').textContent = 'Call ended.';
    }

    start();
  </script>
</body>
</html>

